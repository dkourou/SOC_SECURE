
<mxfile>
  <diagram name="SOC Network Topology">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="internet" value="Internet" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pfsense" value="pfSense&#xa;WAN: 10.0.2.15&#xa;LAN: 192.168.1.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="kali" value="Kali Linux&#xa;192.168.1.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="wazuh" value="Wazuh SIEM&#xa;192.168.1.102" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="targets" value="Targets&#xa;192.168.1.X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="520" y="260" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="edge1" style="endArrow=block;" edge="1" parent="1" source="internet" target="pfsense">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" style="endArrow=block;" edge="1" parent="1" source="pfsense" target="kali">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge3" style="endArrow=block;" edge="1" parent="1" source="pfsense" target="wazuh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge4" style="endArrow=block;" edge="1" parent="1" source="pfsense" target="targets">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
