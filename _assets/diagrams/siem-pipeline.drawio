<mxfile>
  <diagram name="SIEM Pipeline">
    <mxGraphModel>
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="src" value="Sources&#xa;pfSense&#xa;Endpoints&#xa;Kali" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="logs" value="Logs&#xa;(auth, firewall, system)" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="agent" value="Wazuh Agent / Syslog" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="manager" value="Wazuh Manager&#xa;(Rules + Decoders)" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="indexer" value="Indexer (OpenSearch)" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="dashboard" value="Dashboard (Wazuh)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="1140" y="120" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="alert" value="Alerts / Rules Level ≥5" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="1380" y="120" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell edge="1" parent="1" source="src" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="logs" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="agent" target="manager"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="manager" target="indexer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="indexer" target="dashboard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell edge="1" parent="1" source="dashboard" target="alert"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
